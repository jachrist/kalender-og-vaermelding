# Kopier til .env for lokal utvikling: cp .env.example .env
# I produksjon (Azure App Service) settes disse som Application settings i stedet.

# Port Express lytter på (App Service injiserer PORT automatisk).
PORT=3000

# Sti til SQLite-filen. Lokalt: relativt til api/. På App Service: /home/data/... (vedvarende).
SQLITE_DB_PATH=./data/hytteportal.db

# Katalog for opplastede bilder (Hyttebok). På App Service: /home/data/uploads (vedvarende).
UPLOAD_DIR=./data/uploads

# Første administrator som seedes ved oppstart.
ADMIN_EMAIL=din-epost@example.com
ADMIN_NAME=Ditt Navn

# Microsoft Graph (sendMail) for engangskoder. La stå tomt lokalt —
# da logges koden til konsollen i stedet for å sendes på e-post.
TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
MAIL_SENDER=hytteportal@dittdomene.no
MAIL_FROM_NAME=Hytteportal
